Name:		antlr4
Version:	4.13.2
Release:	1
Summary:	ANTLR 4 runtime
Group:		Development/Java
License:	BSD
URL:		https://www.antlr.org/
Source0:	https://github.com/antlr/antlr4/archive/refs/tags/%{version}.tar.gz#/antlr4-%{version}.tar.gz

BuildArch:	noarch
BuildRequires:	python
# Literal, so the first rpmbuild -bs records them before sysjar is installed.
BuildRequires:	maven
BuildRequires:	java-current-devel
BuildSystem:	maven
BuildOption(install):	--file-name antlr4-runtime

Obsoletes:	%{name}-runtime < %{version}-%{release}
Obsoletes:	%{name}-maven-plugin < %{version}-%{release}
Obsoletes:	%{name}-javadoc < %{version}-%{release}

%description
ANTLR 4 reads a grammar and generates a parser. This package ships
the 4.13.2 runtime that those generated parsers link against.
4.5.2 is eight years older, and its serialized ATN does not load in
a current runtime. The compiler release is 8, and the jar is an
automatic module named org.antlr.antlr4.runtime. The grammar tool
and the Maven plugin are left out: the tool's own parser is
generated by ANTLR 3, its Unicode data is rendered from ICU, and
the upstream build shades that into a complete jar. Tests are
skipped.

%prep
%autosetup -n %{name}-%{version}
rm -rf tool tool-testsuite runtime-testsuite antlr4-maven-plugin doc docker scripts .github
find . -name '*.jar' -delete
find . \( -name '*.so' -o -name '*.dll' -o -name '*.dylib' -o -name '*.class' \) -delete
python - <<'PY'
from pathlib import Path

for rel in ("tool", "tool-testsuite", "runtime-testsuite", "antlr4-maven-plugin"):
    if Path(rel).exists():
        raise SystemExit(rel + " remains")
java_files = list(Path("runtime/Java/src").rglob("*.java"))
if len(java_files) != 174:
    raise SystemExit("java files " + str(len(java_files)))
if list(Path(".").rglob("*.jar")) or list(Path(".").rglob("*.so")) or list(Path(".").rglob("*.dll")):
    raise SystemExit("prebuilt binary remains")
bundled = Path("runtime/Java/lib/org.abego.treelayout.core.jar")
if bundled.exists():
    raise SystemExit("bundled treelayout jar remains")
for pom in Path(".").rglob("pom.xml"):
    pom.unlink()

Path("pom.xml").write_text("""<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.antlr</groupId>
  <artifactId>antlr4-runtime</artifactId>
  <version>%{version}</version>
  <packaging>jar</packaging>
  <name>ANTLR 4 Runtime</name>
  <description>Runtime used by parsers generated by ANTLR 4.</description>
  <url>https://www.antlr.org/</url>
  <licenses>
    <license>
      <name>BSD-3-Clause</name>
      <url>https://www.antlr.org/license.html</url>
    </license>
  </licenses>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>8</maven.compiler.release>
  </properties>
  <build>
    <sourceDirectory>runtime/Java/src</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.12.1</version>
        <configuration>
          <release>8</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>org.antlr.antlr4.runtime</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
""", encoding="utf-8")
pom = Path("pom.xml").read_text(encoding="utf-8")
poms = sorted(str(path) for path in Path(".").rglob("pom.xml"))
if poms != ["pom.xml"]:
    raise SystemExit("poms " + str(poms))
for needle in (
    "<artifactId>antlr4-runtime</artifactId>",
    "<version>%{version}</version>",
    "<release>8</release>",
    "<sourceDirectory>runtime/Java/src</sourceDirectory>",
    "<Automatic-Module-Name>org.antlr.antlr4.runtime</Automatic-Module-Name>",
):
    if needle not in pom:
        raise SystemExit("pom missing " + needle)
for needle in ("icu", "treelayout", "shade", "bundle", "graphviz", "SNAPSHOT", "<source>", "<target>", "<parent>", "antlr-runtime", "maven-plugin"):
    if needle in pom:
        raise SystemExit("pom still contains " + needle)
PY

%build -a
java --module-path target/antlr4-runtime-%{version}.jar --describe-module org.antlr.antlr4.runtime > module-describe.txt
# A versioned jar prints "name@version ... automatic", not "name automatic".
grep -q '^org.antlr.antlr4.runtime' module-describe.txt || { cat module-describe.txt; exit 1; }
grep -q ' automatic$' module-describe.txt || { cat module-describe.txt; exit 1; }

%files -f .mfiles
%doc LICENSE.txt README.md CHANGES.txt
